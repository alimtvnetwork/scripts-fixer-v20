{
  "_comment": "Profile alias map. Two kinds of entries:",
  "_kinds": {
    "exact":    "Hard rename -- silently resolves to target (e.g. 'git' -> 'git-compact').",
    "fallback": "Soft mapping -- target is the closest local profile for a profile that doesn't exist locally yet (e.g. 'dev' -> 'base'). Emits a [ WARN ] before running."
  },
  "aliases": {
    "git":         { "kind": "exact",    "target": "git-compact" },
    "gitcompact":  { "kind": "exact",    "target": "git-compact" },
    "cppdx":       { "kind": "exact",    "target": "cpp-dx" },
    "smalldev":    { "kind": "exact",    "target": "small-dev" },
    "antigravity-profile": { "kind": "exact", "target": "antigravity" },
    "all-ai":      { "kind": "exact",    "target": "ai-tools" },
    "ai":          { "kind": "exact",    "target": "ai-tools" },
    "ai-suite":    { "kind": "exact",    "target": "ai-tools" },
    "terminal-profile": { "kind": "exact", "target": "terminal" },
    "profile-terminal": { "kind": "exact", "target": "terminal" },
    "term":             { "kind": "exact", "target": "terminal" },
    "cli":              { "kind": "exact", "target": "terminal" },

    "developer":    { "kind": "exact",    "target": "dev" },
    "devadvance":   { "kind": "exact",    "target": "dev-advance" },
    "dev-advanced": { "kind": "exact",    "target": "dev-advance" },
    "full":         { "kind": "exact",    "target": "dev-advance" }
  }
}
