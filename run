#!/bin/bash
# Self-healing CRLF normalization: strip Windows \r from all shell scripts
# before executing. This runs silently and fixes any stale checkout issues.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
find "$SCRIPT_DIR/scripts" -name "*.sh" -exec sed -i 's/\r$//' {} + 2>/dev/null
sed -i 's/\r$//' "$SCRIPT_DIR/scripts/run.sh" 2>/dev/null
bash "$SCRIPT_DIR/scripts/run.sh" "$@"
