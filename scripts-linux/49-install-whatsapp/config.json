{
  "_comment": "49-install-whatsapp config. 4-tier install chain: Tier 1 (snap), Tier 2 (flatpak), Tier 3 (.deb fallback from GitHub releases), Tier 4 (browser PWA wrapper). Every download/install step enforces a timeout.",
  "snap": {
    "enabled": true,
    "packageName": "whatsapp-for-linux"
  },
  "flatpak": {
    "enabled": true,
    "appIds": [
      "io.github.eneshecan.WhatsAppForLinux",
      "com.github.xeco23.WasIstLos"
    ],
    "remote": "flathub",
    "remoteUrl": "https://dl.flathub.org/repo/flathub.flatpakrepo"
  },
  "debFallback": {
    "enabled": true,
    "packageName": "wasistlos",
    "repo": "eneshecan/whatsapp-for-linux",
    "assetPattern": "_amd64.deb"
  },
  "pwa": {
    "enabled": true,
    "browsers": [
      "google-chrome",
      "google-chrome-stable",
      "chromium-browser",
      "chromium",
      "brave-browser",
      "brave"
    ],
    "targetUrl": "https://web.whatsapp.com"
  },
  "timeouts": {
    "_comment": "Seconds. Applied to every download and installer step via curl --max-time and the timeout(1) guard.",
    "downloadSeconds": 300,
    "installSeconds": 600
  }
}