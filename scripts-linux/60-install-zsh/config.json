{
  "description": "Install zsh + Oh-My-Zsh, deploy curated .zshrc, auto-backup existing config.",
  "install": {
    "apt": "zsh git curl wget",
    "brew": "zsh git curl wget"
  },
  "default_theme": "robbyrussell",
  "theme_preset": "",
  "_theme_preset_doc": "Opt-in registry key. Supported: 'powerlevel10k' (clones romkatv/powerlevel10k as OMZ custom theme), 'starship' (installs starship prompt binary + wires init in extras; ZSH_THEME left blank), 'spaceship' (clones spaceship-prompt as OMZ custom theme). Empty = use default_theme as-is.",
  "theme_presets": {
    "powerlevel10k": {
      "type":      "omz-custom-theme",
      "repo":      "https://github.com/romkatv/powerlevel10k.git",
      "zsh_theme": "powerlevel10k/powerlevel10k",
      "dest_rel":  "custom/themes/powerlevel10k"
    },
    "spaceship": {
      "type":      "omz-custom-theme",
      "repo":      "https://github.com/spaceship-prompt/spaceship-prompt.git",
      "zsh_theme": "spaceship",
      "dest_rel":  "custom/themes/spaceship-prompt",
      "post_symlink": {
        "from": "custom/themes/spaceship-prompt/spaceship.zsh-theme",
        "to":   "custom/themes/spaceship.zsh-theme"
      }
    },
    "starship": {
      "type":      "external-prompt",
      "install_sh": "curl -fsSL https://starship.rs/install.sh | sh -s -- -y",
      "zsh_theme": "",
      "extras_line": "command -v starship >/dev/null 2>&1 && eval \"$(starship init zsh)\""
    }
  },
  "plugins": ["git", "z", "sudo", "history", "command-not-found", "zsh-autosuggestions", "zsh-syntax-highlighting", "history-substring-search"],
  "custom_plugins": [
    {
      "name": "zsh-autosuggestions",
      "repo": "https://github.com/zsh-users/zsh-autosuggestions",
      "dest": "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
    },
    {
      "name": "zsh-syntax-highlighting",
      "repo": "https://github.com/zsh-users/zsh-syntax-highlighting",
      "dest": "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting"
    },
    {
      "name": "zsh-history-substring-search",
      "repo": "https://github.com/zsh-users/zsh-history-substring-search",
      "dest": "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/history-substring-search"
    }
  ],
  "deploy_zshrc": true,
  "deploy_extras": true,
  "backup_existing_zshrc": true,
  "set_default_shell": false,
  "omz_install_url": "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh",
  "powerlevel10k_repo": "https://github.com/romkatv/powerlevel10k.git"
}
