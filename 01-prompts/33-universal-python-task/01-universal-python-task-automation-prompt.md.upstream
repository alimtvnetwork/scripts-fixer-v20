> [!TIP]
> **Executable Production Blueprint & Shared Engine:** The complete, tested reference implementation is maintained under [`01-prompts/33-universal-python-task/code/`](code/) and the reusable multi-domain automation engine is maintained under [`03-ai-scripts/70-python-task-standards-engine.py`](../../03-ai-scripts/70-python-task-standards-engine.py). Downstream AI agents should ingest `code/readme.md` and replicate the modular structure.

### 0. `scripts/app_errors.py` (Monadic Error Architecture & Result[T])
```python
"""scripts/app_errors.py — Structured application errors and monadic Result container."""

from dataclasses import dataclass, field
from typing import Any, Generic, TypeVar

T = TypeVar("T")


@dataclass(frozen=True)
class AppError:
    code: str
    message: str
    operation: str = ""
    details: dict[str, Any] = field(default_factory=dict)
    cause_message: str | None = None

    def to_dict(self) -> dict[str, Any]:
        return {"code": self.code, "message": self.message, "operation": self.operation, "details": self.details}


class Result(Generic[T]):
    def __init__(self, value: T | None, error: AppError | None, is_safe: bool) -> None:
        self._value = value
        self._error = error
        self._is_safe = is_safe

    @classmethod
    def ok(cls, value: T) -> Result[T]:
        return cls(value=value, error=None, is_safe=True)

    @classmethod
    def fail(cls, error: AppError) -> Result[T]:
        return cls(value=None, error=error, is_safe=False)

    @property
    def is_safe(self) -> bool:
        return self._is_safe

    @property
    def has_error(self) -> bool:
        return not self._is_safe

    @property
    def value(self) -> T:
        if self.has_error:
            raise RuntimeError(f"Cannot unwrap failed result: {self._error}")
        return self._value  # type: ignore[return-value]

    @property
    def error(self) -> AppError:
        if self.is_safe:
            raise RuntimeError("Cannot access error on successful result")
        return self._error  # type: ignore[return-value]
```

### 1. `scripts/core_enums.py` (Enums & Constants)
```python
"""scripts/core_enums.py — Strongly-typed enums for action dispatch and statuses."""

from enum import IntEnum, StrEnum


class ActionType(StrEnum):
    STATUS = "status"
    SCAN = "scan"
    PURGE = "purge"
    RESTART = "restart"
    REPORT = "report"


class TaskCategoryType(StrEnum):
    ALL = "all"
    OS_CACHE = "os_cache"
    DEBUG_BUILDS = "debug_builds"
    AUDIO_DEVICE = "audio_device"
    VMWARE_NETWORK = "vmware_network"
    WHATSAPP_CACHE = "whatsapp_cache"
    USER_ACCOUNT = "user_account"


class ExitCodeType(IntEnum):
    SUCCESS = 0
    GENERAL_ERROR = 1
    INVALID_USAGE = 2
    ACCESS_DENIED = 3
    NOT_FOUND = 4
```

### 2. `scripts/logger.py` (Structured Dual Logging)
```python
"""scripts/logger.py — Structured console and file logging."""

from datetime import datetime
from pathlib import Path
import sys


class TaskLogger:
    def __init__(self, log_path: Path):
        self.log_path = log_path
        self.log_path.parent.mkdir(parents=True, exist_ok=True)

    def log_message(self, level: str, message: str) -> None:
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        formatted = f"[{timestamp}] [{level.upper()}] {message}"
        print(formatted)
        with open(self.log_path, "a", encoding="utf-8") as f:
            f.write(formatted + "\n")

    def info(self, message: str) -> None:
        self.log_message("info", message)

    def warn(self, message: str) -> None:
        self.log_message("warn", message)

    def error(self, message: str) -> None:
        self.log_message("error", message)
```

### 3. `scripts/task_runner.py` (Modular Execution Handlers)
```python
"""scripts/task_runner.py — Task action handlers (<= 15 lines per function)."""

from pathlib import Path
import subprocess
from core_enums import ActionType, ExitCodeType, TaskCategoryType
from logger import TaskLogger

PROTECTED_NAMES = {".gitkeep", "config.json", "settings.json"}


def is_protected_file(file_path: Path) -> bool:
    return file_path.name in PROTECTED_NAMES


def scan_cache_directory(target_dir: Path) -> tuple[list[Path], int]:
    if not target_dir.is_dir():
        return [], 0
    files = [p for p in target_dir.rglob("*") if p.is_file() and not is_protected_file(p)]
    total_bytes = sum(f.stat().st_size for f in files)
    return files, total_bytes


def purge_file_safely(file_path: Path, is_dry_run: bool, logger: TaskLogger) -> bool:
    if is_dry_run:
        logger.info(f"[DRY-RUN] Would remove: {file_path}")
        return True
    try:
        file_path.unlink(missing_ok=True)
        return True
    except OSError as err:
        logger.warn(f"Failed to remove {file_path}: {err}")
        return False


def execute_cache_purge(target_dir: Path, is_dry_run: bool, logger: TaskLogger) -> int:
    files, total_bytes = scan_cache_directory(target_dir)
    mb_size = round(total_bytes / (1024 * 1024), 2)
    logger.info(f"Target directory: {target_dir} ({len(files)} files, {mb_size} MB)")
    purged_count = sum(1 for f in files if purge_file_safely(f, is_dry_run, logger))
    logger.info(f"Purge complete: {purged_count}/{len(files)} files processed.")
    return ExitCodeType.SUCCESS


def purge_debug_builds(target_dir: Path, is_dry_run: bool, logger: TaskLogger) -> int:
    patterns = ["**/target/debug", "**/bin/Debug", "**/obj/Debug", "**/__pycache__"]
    logger.info(f"Scanning for debug build artifacts in {target_dir}...")
    for pat in patterns:
        for match in target_dir.glob(pat):
            if is_dry_run:
                logger.info(f"[DRY-RUN] Would purge build artifact: {match}")
                continue
            logger.info(f"Purging build artifact: {match}")
    return ExitCodeType.SUCCESS


def restart_windows_audio_service(is_dry_run: bool, logger: TaskLogger) -> int:
    services = ["Audiosrv", "AudioEndpointBuilder"]
    for svc in services:
        if is_dry_run:
            logger.info(f"[DRY-RUN] Would restart audio service: {svc}")
            continue
        logger.info(f"Restarting service {svc}...")
        subprocess.run(["net", "stop", svc, "/y"], capture_output=True, check=False)
        subprocess.run(["net", "start", svc], capture_output=True, check=False)
    return ExitCodeType.SUCCESS


def reset_network_adapters(adapter_name: str, is_dry_run: bool, logger: TaskLogger) -> int:
    if is_dry_run:
        logger.info(f"[DRY-RUN] Would reset network adapter: {adapter_name}")
        return ExitCodeType.SUCCESS
    logger.info(f"Resetting network adapter: {adapter_name}...")
    cmd_disable = ["netsh", "interface", "set", "interface", adapter_name, "admin=disable"]
    cmd_enable = ["netsh", "interface", "set", "interface", adapter_name, "admin=enable"]
    subprocess.run(cmd_disable, capture_output=True, check=False)
    subprocess.run(cmd_enable, capture_output=True, check=False)
    return ExitCodeType.SUCCESS


def clean_desktop_app_cache(app_cache_dir: Path, is_dry_run: bool, logger: TaskLogger) -> int:
    if not app_cache_dir.is_dir():
        logger.warn(f"Cache directory not found: {app_cache_dir}")
        return ExitCodeType.NOT_FOUND
    return execute_cache_purge(app_cache_dir, is_dry_run, logger)
```

### 4. `scripts/cli_dispatcher.py` (CLI & Suggestions)
```python
"""scripts/cli_dispatcher.py — CLI entrypoint with formatted help and suggestions."""

import argparse
from pathlib import Path
import sys
from core_enums import ActionType, ExitCodeType, TaskCategoryType
from logger import TaskLogger
from task_runner import (
    execute_cache_purge,
    purge_debug_builds,
    restart_windows_audio_service,
    reset_network_adapters,
    clean_desktop_app_cache,
)


def create_argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Autonomous Task CLI Runner — executes modular system automation tasks."
    )
    parser.add_argument("action", choices=[a.value for a in ActionType], help="Action to execute")
    parser.add_argument("--category", choices=[c.value for c in TaskCategoryType], default=TaskCategoryType.OS_CACHE.value)
    parser.add_argument("--target", type=str, default=".", help="Target path for operation")
    parser.add_argument("--adapter", type=str, default="VMware Network Adapter VMnet8", help="Network adapter name")
    parser.add_argument("--all", action="store_true", help="Execute across all supported categories")
    parser.add_argument("--dry-run", action="store_true", help="Simulate execution without modifying state")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    return parser


def print_suggestions(action: str, category: str) -> None:
    print("\n💡 Suggested Next Actions:")
    if action == ActionType.SCAN.value:
        print("  1. Review scanned targets above.")
        print(f"  2. Run simulation:  ./run.ps1 purge --category {category} --dry-run")
        print(f"  3. Run live purge:  ./run.ps1 purge --category {category}")
    elif action == ActionType.PURGE.value:
        print("  1. Verify freed disk space: ./run.ps1 status")
        print("  2. Check detailed audit: cat logs/task.log")
    elif action == ActionType.RESTART.value:
        print("  1. Verify device functionality.")
        print("  2. Confirm service status: ./run.ps1 status")


def main() -> int:
    parser = create_argument_parser()
    args = parser.parse_args()
    log_dir = Path(__file__).resolve().parent.parent / "logs"
    logger = TaskLogger(log_dir / "task.log")
    logger.info(f"CLI Dispatcher initiated: action={args.action}, category={args.category}, dry_run={args.dry_run}")

    target_path = Path(args.target).resolve()
    exit_code = ExitCodeType.SUCCESS

    if args.action in [ActionType.SCAN.value, ActionType.PURGE.value]:
        if args.all or args.category == TaskCategoryType.OS_CACHE.value:
            execute_cache_purge(target_path, args.dry_run, logger)
        if args.all or args.category == TaskCategoryType.DEBUG_BUILDS.value:
            purge_debug_builds(target_path, args.dry_run, logger)
        if args.category == TaskCategoryType.WHATSAPP_CACHE.value:
            clean_desktop_app_cache(target_path, args.dry_run, logger)
    elif args.action == ActionType.RESTART.value:
        if args.category == TaskCategoryType.AUDIO_DEVICE.value:
            restart_windows_audio_service(args.dry_run, logger)
        elif args.category == TaskCategoryType.VMWARE_NETWORK.value:
            reset_network_adapters(args.adapter, args.dry_run, logger)
    else:
        logger.info(f"Action {args.action} acknowledged and verified.")

    print_suggestions(args.action, args.category)
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
```

