"""Elementor Flexbox Container and widget AST generator."""
from __future__ import annotations

import secrets
from typing import Any
from scripts.core_enums import WidgetType


def generate_elementor_id() -> str:
    """Generate 7-character hexadecimal Elementor element ID."""
    return secrets.token_hex(4)[:7]


def create_container(
    direction: str = "column",
    gap_px: int = 24,
    element_id: str = "",
    css_classes: str = "",
    custom_css: str = "",
    is_inner: bool = False,
    elements: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    """Build modern Elementor Flexbox Container."""
    return {
        "id": generate_elementor_id(),
        "elType": "container",
        "isInner": is_inner,
        "settings": {
            "_element_id": element_id,
            "_css_classes": css_classes,
            "container_type": "flex",
            "flex_direction": direction,
            "gap": {"unit": "px", "size": gap_px},
            "custom_css": custom_css,
        },
        "elements": elements or [],
    }


def create_heading(title: str, size: str = "h2", element_id: str = "") -> dict[str, Any]:
    """Build Elementor heading widget."""
    return {
        "id": generate_elementor_id(),
        "elType": "widget",
        "widgetType": WidgetType.HEADING.value,
        "settings": {
            "_element_id": element_id,
            "title": title,
            "header_size": size,
        },
        "elements": [],
    }


def create_button(text: str, url: str, element_id: str = "") -> dict[str, Any]:
    """Build Elementor button widget."""
    return {
        "id": generate_elementor_id(),
        "elType": "widget",
        "widgetType": WidgetType.BUTTON.value,
        "settings": {
            "_element_id": element_id,
            "text": text,
            "link": {"url": url},
        },
        "elements": [],
    }
