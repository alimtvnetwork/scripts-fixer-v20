### 10.6 `scripts/task_logger.py` (Dual-Channel Logger)
```python
"""Dual-channel logging: ANSI formatted stdout and structured JSON files."""
from __future__ import annotations

import json
from datetime import datetime
from pathlib import Path


class TaskLogger:
    def __init__(self, log_path: Path | None = None) -> None:
        self.log_path = log_path
        self.events: list[dict[str, str]] = []

    def info(self, msg: str) -> None:
        print(f"\033[36m[ INFO ]\033[0m {msg}")
        self._record("INFO", msg)

    def success(self, msg: str) -> None:
        print(f"\033[32m[  OK  ]\033[0m {msg}")
        self._record("SUCCESS", msg)

    def warn(self, msg: str) -> None:
        print(f"\033[33m[ WARN ]\033[0m {msg}")
        self._record("WARN", msg)

    def error(self, msg: str) -> None:
        print(f"\033[31m[ FAIL ]\033[0m {msg}")
        self._record("ERROR", msg)

    def _record(self, level: str, msg: str) -> None:
        entry = {"timestamp": datetime.utcnow().isoformat() + "Z", "level": level, "message": msg}
        self.events.append(entry)
        if self.log_path:
            self.log_path.parent.mkdir(parents=True, exist_ok=True)
            with open(self.log_path, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry) + "\n")
```

### 10.7 `scripts/wp_auth_crypto.py` (RSA-OAEP Asymmetric Encryption)
```python
"""RSA-OAEP asymmetric encryption & key management."""
from __future__ import annotations

import base64
import hashlib
from dataclasses import dataclass


@dataclass(frozen=True)
class RsaCipherEnvelope:
    algorithm: str
    key_size_bits: int
    key_fingerprint: str
    encrypted_secret: str
    is_app_password: bool


def compute_key_fingerprint(public_key_pem: bytes) -> str:
    digest = hashlib.sha256(public_key_pem).hexdigest()
    return f"SHA256:{digest[:32]}"


def encrypt_rsa_oaep(secret: str, pub_pem: bytes, is_app_password: bool = True) -> RsaCipherEnvelope:
    try:
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import padding
        from cryptography.hazmat.primitives.serialization import load_pem_public_key

        pub_key = load_pem_public_key(pub_pem)
        cipher_bytes = pub_key.encrypt(
            secret.encode("utf-8"),
            padding.OAEP(mgf=padding.MGF1(hashes.SHA256()), algorithm=hashes.SHA256(), label=None),
        )
        return RsaCipherEnvelope("RSA-OAEP-SHA256", 2048, compute_key_fingerprint(pub_pem), base64.b64encode(cipher_bytes).decode("ascii"), is_app_password)
    except ImportError:
        p1 = base64.b64encode(secret.encode("utf-8")).decode("ascii")
        p2 = base64.b64encode(p1.encode("ascii")).decode("ascii")
        p3 = base64.b64encode(p2.encode("ascii")).decode("ascii")
        return RsaCipherEnvelope("3STAGE-BASE64", 2048, compute_key_fingerprint(pub_pem or b"fallback"), p3, is_app_password)


def decrypt_rsa_oaep(ciphertext_b64: str, priv_pem: bytes) -> str:
    try:
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import padding
        from cryptography.hazmat.primitives.serialization import load_pem_private_key

        priv_key = load_pem_private_key(priv_pem, password=None)
        raw_bytes = base64.b64decode(ciphertext_b64.encode("ascii"))
        return priv_key.decrypt(raw_bytes, padding.OAEP(mgf=padding.MGF1(hashes.SHA256()), algorithm=hashes.SHA256(), label=None)).decode("utf-8")
    except ImportError:
        p2 = base64.b64decode(ciphertext_b64.encode("ascii")).decode("ascii")
        p1 = base64.b64decode(p2.encode("ascii")).decode("ascii")
        return base64.b64decode(p1.encode("ascii")).decode("utf-8")
```

### 10.8 `scripts/wp_credential_repo.py` (Isolated Temp SQLite Credential Repository)
```python
"""SQLite credential repository located in system temp directory (isolated from Git)."""
from __future__ import annotations

import sqlite3
import tempfile
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Iterator, Protocol


@dataclass(frozen=True)
class WpCredentialRecord:
    site_url: str
    username: str
    password_type: str
    encrypted_secret: str
    encryption_algo: str
    rsa_key_fingerprint: str
    is_active: bool = True
    has_app_password: bool = True
    created_at: str = ""
    updated_at: str = ""


class IWpCredentialRepository(Protocol):
    def save_credential(self, record: WpCredentialRecord) -> bool: ...
    def get_credential(self, site_url: str, username: str) -> WpCredentialRecord | None: ...
    def delete_credential(self, site_url: str, username: str) -> bool: ...
    def list_credentials(self) -> list[WpCredentialRecord]: ...


class SqliteWpCredentialRepository:
    def __init__(self, db_path: Path | str | None = None) -> None:
        if db_path is None:
            self._db_path = Path(tempfile.gettempdir()) / "gitmap" / "wp_credentials.db"
        else:
            self._db_path = Path(db_path)
        self._ensure_db_dir()
        self._init_db()

    def _ensure_db_dir(self) -> None:
        if not self._db_path.parent.exists():
            self._db_path.parent.mkdir(parents=True, exist_ok=True)

    @contextmanager
    def _open_conn(self) -> Iterator[sqlite3.Connection]:
        conn = sqlite3.connect(str(self._db_path), timeout=5.0)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA busy_timeout = 5000;")
        try:
            yield conn
            conn.commit()
        finally:
            conn.close()

    def _init_db(self) -> None:
        sql = """
        CREATE TABLE IF NOT EXISTS WpCredentials (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            siteUrl TEXT NOT NULL,
            username TEXT NOT NULL,
            passwordType TEXT NOT NULL,
            encryptedSecret TEXT NOT NULL,
            encryptionAlgo TEXT NOT NULL,
            rsaKeyFingerprint TEXT NOT NULL,
            isActive INTEGER NOT NULL DEFAULT 1,
            hasAppPassword INTEGER NOT NULL DEFAULT 1,
            createdAt TEXT NOT NULL,
            updatedAt TEXT NOT NULL
        );
        CREATE UNIQUE INDEX IF NOT EXISTS idx_wp_cred_site_user ON WpCredentials(siteUrl, username);
        """
        with self._open_conn() as conn:
            conn.executescript(sql)

    def save_credential(self, record: WpCredentialRecord) -> bool:
        now = datetime.utcnow().isoformat() + "Z"
        sql = """
        INSERT INTO WpCredentials (siteUrl, username, passwordType, encryptedSecret, encryptionAlgo, rsaKeyFingerprint, isActive, hasAppPassword, createdAt, updatedAt)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(siteUrl, username) DO UPDATE SET
            passwordType=excluded.passwordType, encryptedSecret=excluded.encryptedSecret,
            encryptionAlgo=excluded.encryptionAlgo, rsaKeyFingerprint=excluded.rsaKeyFingerprint,
            isActive=excluded.isActive, hasAppPassword=excluded.hasAppPassword, updatedAt=excluded.updatedAt;
        """
        params = (record.site_url, record.username, record.password_type, record.encrypted_secret, record.encryption_algo, record.rsa_key_fingerprint, 1 if record.is_active else 0, 1 if record.has_app_password else 0, record.created_at or now, now)
        with self._open_conn() as conn:
            conn.execute(sql, params)
        return True

    def get_credential(self, site_url: str, username: str) -> WpCredentialRecord | None:
        sql = "SELECT * FROM WpCredentials WHERE siteUrl = ? AND username = ? AND isActive = 1;"
        with self._open_conn() as conn:
            row = conn.execute(sql, (site_url, username)).fetchone()
        if row is None:
            return None
        return WpCredentialRecord(row["siteUrl"], row["username"], row["passwordType"], row["encryptedSecret"], row["encryptionAlgo"], row["rsaKeyFingerprint"], bool(row["isActive"]), bool(row["hasAppPassword"]), row["createdAt"], row["updatedAt"])
```

### 10.9 `scripts/wp_auth.py` (Connection Probe & Dispatch)
```python
"""Connection probe and authentication dispatcher."""
from __future__ import annotations

import base64
import json
import urllib.request
from typing import Any
from scripts.app_errors import AppError, Result


def probe_wp_connection(site_url: str, username: str, password: str) -> Result[dict[str, Any]]:
    """Probe WordPress REST API endpoint to assert credentials and roles."""
    url = f"{site_url.rstrip('/')}/wp-json/wp/v2/users/me"
    auth_header = "Basic " + base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("utf-8")
    req = urllib.request.Request(url, headers={"Authorization": auth_header, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return Result.ok(data)
    except Exception as e:
        return Result.fail(AppError("AUTH_FAILURE", f"Connection probe failed: {e}"))
```

### 10.10 `scripts/wp_rest_client.py` (REST Pages CRUD & Rollback)
```python
"""WordPress REST API client managing pages, preflight backups, and rollback."""
from __future__ import annotations

import base64
import json
import urllib.request
from datetime import datetime
from pathlib import Path
from scripts.app_errors import AppError, Result


class WpRestClient:
    def __init__(self, site_url: str, username: str, password: str) -> None:
        self.site_url = site_url.rstrip("/")
        self.auth_token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("utf-8")

    def _headers(self) -> dict[str, str]:
        return {
            "Authorization": f"Basic {self.auth_token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        }

    def get_page(self, page_id: int) -> Result[dict[str, Any]]:
        url = f"{self.site_url}/wp-json/wp/v2/pages/{page_id}?context=edit"
        req = urllib.request.Request(url, headers=self._headers())
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return Result.ok(json.loads(resp.read().decode("utf-8")))
        except Exception as e:
            return Result.fail(AppError("PAGE_FETCH_ERROR", str(e)))

    def create_preflight_backup(self, page_id: int, registry_path: Path) -> Result[int]:
        fetch_res = self.get_page(page_id)
        if fetch_res.is_failure:
            return Result.fail(fetch_res.error)

        page = fetch_res.value
        title = page.get("title", {}).get("raw", "Untitled")
        meta = page.get("meta", {})
        backup_title = f"{title} - Backup [{datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')}]"

        payload = {
            "title": backup_title,
            "status": "draft",
            "content": page.get("content", {}).get("raw", ""),
            "meta": meta,
        }
        create_res = self._post_json(f"{self.site_url}/wp-json/wp/v2/pages", payload)
        if create_res.is_failure:
            return Result.fail(create_res.error)

        backup_id = create_res.value.get("id")
        self._record_backup(registry_path, page_id, backup_id, title)
        return Result.ok(backup_id)

    def update_page_ast(self, page_id: int, ast_json_str: str) -> Result[bool]:
        payload = {
            "meta": {
                "_elementor_data": ast_json_str,
                "_elementor_edit_mode": "builder",
            }
        }
        res = self._post_json(f"{self.site_url}/wp-json/wp/v2/pages/{page_id}", payload)
        if res.is_failure:
            return Result.fail(res.error)
        return Result.ok(True)

    def restore_backup(self, page_id: int, backup_id: int) -> Result[bool]:
        backup_res = self.get_page(backup_id)
        if backup_res.is_failure:
            return Result.fail(backup_res.error)

        meta = backup_res.value.get("meta", {})
        payload = {"meta": meta}
        res = self._post_json(f"{self.site_url}/wp-json/wp/v2/pages/{page_id}", payload)
        if res.is_failure:
            return Result.fail(res.error)
        return Result.ok(True)

    def _post_json(self, url: str, data: dict[str, Any]) -> Result[dict[str, Any]]:
        raw = json.dumps(data).encode("utf-8")
        req = urllib.request.Request(url, data=raw, headers=self._headers(), method="POST")
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return Result.ok(json.loads(resp.read().decode("utf-8")))
        except Exception as e:
            return Result.fail(AppError("REST_POST_ERROR", str(e)))

    def _record_backup(self, registry_path: Path, page_id: int, backup_id: int, title: str) -> None:
        records = []
        if registry_path.exists():
            try:
                with open(registry_path, "r", encoding="utf-8") as f:
                    records = json.load(f)
            except Exception:
                pass
        records.append({
            "original_id": page_id,
            "backup_id": backup_id,
            "title": title,
            "timestamp": datetime.utcnow().isoformat() + "Z",
        })
        with open(registry_path, "w", encoding="utf-8") as f:
            json.dump(records, f, indent=2)
```

