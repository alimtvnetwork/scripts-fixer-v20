### 10.12 `scripts/visual_diff.py` (Pillow Headless Diffing)
```python
"""Headless visual comparison and mismatch percentage calculator using Pillow."""
from __future__ import annotations

import math
from pathlib import Path
from PIL import Image, ImageChops
from scripts.app_errors import AppError, Result


def compute_visual_diff(
    before_path: Path,
    after_path: Path,
    diff_output_path: Path | None = None,
    tolerance_percent: float = 5.0,
) -> Result[float]:
    """Compare two screenshots, generate difference overlay, and calculate mismatch percentage."""
    if not before_path.exists() or not after_path.exists():
        return Result.fail(AppError("FILE_NOT_FOUND", "Screenshot file(s) do not exist."))

    try:
        img_before = Image.open(before_path).convert("RGB")
        img_after = Image.open(after_path).convert("RGB")

        # Resize to match dimensions if needed
        if img_before.size != img_after.size:
            img_after = img_after.resize(img_before.size, Image.Resampling.LANCZOS)

        diff = ImageChops.difference(img_before, img_after)
        stat = diff.histogram()
        num_pixels = img_before.size[0] * img_before.size[1]

        # Calculate Root Mean Squared Error (RMSE)
        sum_sq = sum(count * (i % 256) ** 2 for i, count in enumerate(stat))
        rmse = math.sqrt(sum_sq / (float(num_pixels) * 3))
        mismatch_percent = (rmse / 255.0) * 100.0

        if diff_output_path:
            diff_output_path.parent.mkdir(parents=True, exist_ok=True)
            diff.save(diff_output_path)

        if mismatch_percent > tolerance_percent:
            return Result.fail(AppError("DIFF_TOLERANCE_EXCEEDED", f"Visual diff {mismatch_percent:.2f}% exceeds {tolerance_percent:.2f}% tolerance"))

        return Result.ok(mismatch_percent)
    except Exception as e:
        return Result.fail(AppError("DIFF_COMPUTATION_ERROR", str(e)))
```

### 10.13 `scripts/transform_protocol.py` (Pluggable Step Protocol & Registry)
```python
"""Pluggable transformation step protocol, context, and registry."""
from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Callable, Protocol, TypeVar

from scripts.app_errors import AppError, Result


class TransformActionType(str, Enum):
    """Supported transformation actions."""
    MODIFY_AST = "modify_ast"
    MODIFY_CSS = "modify_css"
    INJECT_WIDGET = "inject_widget"
    REPLACE_TOKENS = "replace_tokens"
    CUSTOM = "custom"


@dataclass
class TransformContext:
    """Execution context passed through all pipeline transformation steps."""
    site_url: str
    page_id: int
    cache: Any
    params: dict[str, Any] = field(default_factory=dict)
    metadata: dict[str, Any] = field(default_factory=dict)
    has_cache: bool = True
    is_dry_run: bool = False


class ITransformStep(Protocol):
    """Contract for modular, stackable WordPress transformation steps."""
    step_id: str
    description: str
    user_request: str

    def compile(self, context: TransformContext) -> Result[bool]:
        """Pre-flight check verifying step preconditions and parameters."""
        ...

    def modify_ast(self, ast: dict[str, Any], context: TransformContext) -> Result[dict[str, Any]]:
        """Applies AST tree transformations and returns updated AST."""
        ...

    def modify_css(self, existing_css: str, context: TransformContext) -> Result[str]:
        """Applies scoped CSS modifications and returns updated CSS string."""
        ...

    def validate(self, ast: dict[str, Any]) -> Result[bool]:
        """Validates transformed AST against schema rules."""
        ...


TStep = TypeVar("TStep", bound=type)


class TransformRegistry:
    """Registry maintaining available transformation step implementations."""
    _registry: dict[str, type] = {}

    @classmethod
    def register(cls, name: str, step_class: type) -> None:
        cls._registry[name] = step_class

    @classmethod
    def get(cls, name: str) -> type | None:
        return cls._registry.get(name)

    @classmethod
    def list_registered(cls) -> list[str]:
        return sorted(list(cls._registry.keys()))


def register_transform(name: str) -> Callable[[TStep], TStep]:
    """Decorator registering an ITransformStep class under a unique name."""
    def decorator(cls: TStep) -> TStep:
        TransformRegistry.register(name, cls)
        return cls

    return decorator
```

### 10.14 `scripts/pipeline_engine.py` (FileSystemCache & PipelineWrapper)
```python
"""FileSystemCache and PipelineWrapper for WordPress transformation stacks."""
from __future__ import annotations

import hashlib
import importlib
import json
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from scripts.app_errors import AppError, Result
from scripts.transform_protocol import ITransformStep, TransformContext, TransformRegistry


@dataclass(frozen=True)
class CacheEntry:
    content: str
    mtime_ns: int
    sha256_hash: str


class FileSystemCache:
    """Thread-safe caching wrapper with mtime and SHA-256 freshness tracking."""

    def __init__(self) -> None:
        self._store: dict[str, CacheEntry] = {}

    def _calculate_sha256(self, raw_bytes: bytes) -> str:
        return hashlib.sha256(raw_bytes).hexdigest()

    def get_or_load(self, path: Path | str) -> Result[str]:
        p = Path(path).resolve()
        if not p.exists():
            return Result.fail(AppError("FILE_NOT_FOUND", f"File does not exist: {p}"))

        mtime = p.stat().st_mtime_ns
        key = str(p)
        cached = self._store.get(key)
        if cached is not None and cached.mtime_ns == mtime:
            return Result.ok(cached.content)

        try:
            raw = p.read_bytes()
            content = raw.decode("utf-8")
            digest = self._calculate_sha256(raw)
            self._store[key] = CacheEntry(content=content, mtime_ns=mtime, sha256_hash=digest)
            return Result.ok(content)
        except Exception as err:
            return Result.fail(AppError("FILE_READ_ERROR", str(err)))

    def get_json(self, path: Path | str) -> Result[dict[str, Any]]:
        load_res = self.get_or_load(path)
        if load_res.is_failure:
            return Result.fail(load_res.error)

        try:
            parsed = json.loads(load_res.value)
            return Result.ok(parsed)
        except json.JSONDecodeError as err:
            return Result.fail(AppError("JSON_DECODE_ERROR", str(err)))

    def invalidate(self, path: Path | str) -> None:
        key = str(Path(path).resolve())
        self._store.pop(key, None)

    def clear(self) -> None:
        self._store.clear()


class PipelineWrapper:
    """Pluggable execution pipeline that sequences transformation steps."""

    def __init__(self, name: str = "default_pipeline") -> None:
        self.name = name
        self.steps: list[ITransformStep] = []

    def add_step(self, step: ITransformStep) -> None:
        self.steps.append(step)

    @classmethod
    def from_json(cls, config_path: Path | str, cache: FileSystemCache) -> Result[PipelineWrapper]:
        json_res = cache.get_json(config_path)
        if json_res.is_failure:
            return Result.fail(json_res.error)

        cfg = json_res.value
        pipeline = cls(name=cfg.get("pipeline_name", "unnamed_pipeline"))
        step_items = cfg.get("steps", [])
        for item in step_items:
            step_res = cls._load_single_step(item)
            if step_res.is_failure:
                return Result.fail(step_res.error)
            if step_res.value is not None:
                pipeline.add_step(step_res.value)

        return Result.ok(pipeline)

    @classmethod
    def _load_single_step(cls, item: dict[str, Any]) -> Result[ITransformStep | None]:
        is_enabled = bool(item.get("enabled", True))
        if not is_enabled:
            return Result.ok(None)

        class_name = item.get("class_name", "")
        module_name = item.get("module", "")
        reg_step = TransformRegistry.get(class_name)
        if reg_step is not None:
            return Result.ok(reg_step())

        return cls._instantiate_from_module(module_name, class_name)

    @classmethod
    def _instantiate_from_module(cls, module_name: str, class_name: str) -> Result[ITransformStep | None]:
        if not module_name or not class_name:
            return Result.fail(AppError("INVALID_STEP_CONFIG", "Missing module or class_name"))

        try:
            mod = importlib.import_module(module_name)
            cls_type = getattr(mod, class_name)
            return Result.ok(cls_type())
        except Exception as err:
            return Result.fail(AppError("STEP_IMPORT_ERROR", f"Failed importing {module_name}.{class_name}: {err}"))

    def execute(
        self,
        context: TransformContext,
        initial_ast: dict[str, Any],
        initial_css: str = "",
    ) -> Result[dict[str, Any]]:
        current_ast = initial_ast
        current_css = initial_css

        for step in self.steps:
            comp_res = step.compile(context)
            if comp_res.is_failure:
                return Result.fail(comp_res.error)

            ast_res = step.modify_ast(current_ast, context)
            if ast_res.is_failure:
                return Result.fail(ast_res.error)
            current_ast = ast_res.value

            css_res = step.modify_css(current_css, context)
            if css_res.is_failure:
                return Result.fail(css_res.error)
            current_css = css_res.value

            val_res = step.validate(current_ast)
            if val_res.is_failure:
                return Result.fail(val_res.error)

        return Result.ok({"ast": current_ast, "css": current_css, "step_count": len(self.steps)})
```

### 10.15 `scripts/css_engine.py` (Scoped CSS Builder & Token Engine)
```python
"""Scoped CSS builder and design token engine for Elementor components."""
from __future__ import annotations

import re


class ScopedCssBuilder:
    """Utility engine for scoped Elementor CSS styling and token replacement."""

    @staticmethod
    def format_rule_block(selector: str, rules: dict[str, str]) -> str:
        declarations = [f"  {k}: {v};" for k, v in rules.items()]
        decl_body = "\n".join(declarations)
        return f"{selector} {{\n{decl_body}\n}}"

    @classmethod
    def append_scoped_rules(cls, existing_css: str, selector: str, rules: dict[str, str]) -> str:
        new_block = cls.format_rule_block(selector, rules)
        clean_css = existing_css.strip()
        if not clean_css:
            return new_block

        return f"{clean_css}\n\n{new_block}"

    @classmethod
    def replace_scoped_css(cls, existing_css: str, selector: str, new_css: str) -> str:
        pattern = re.compile(rf"{re.escape(selector)}\s*\{{[^}}]*\}}", re.MULTILINE)
        has_match = bool(pattern.search(existing_css))
        if has_match:
            return pattern.sub(new_css.strip(), existing_css).strip()

        return cls.append_scoped_rules(existing_css, selector, {})

    @staticmethod
    def merge_design_tokens(css: str, tokens: dict[str, str]) -> str:
        result = css
        for key, value in tokens.items():
            token_pattern = rf"var\(--{re.escape(key)}\)|__TOKEN_{re.escape(key.upper())}__"
            result = re.sub(token_pattern, value, result)

        return result
```

### 10.16 `scripts/transformations/hero_modernization.py` (Sample Pluggable Transform)
```python
"""
TRANSFORMATION STEP: hero_modernization
================================================================================
USER REQUEST: "Modernize hero section with dark glassmorphism and 60/30/10 colors"
PURPOSE:      Inject updated gradient typography, backdrop blur, and primary CTA
PROCESS:      1. Pre-flight compile check.
              2. Traverse AST to locate target container widget.
              3. Update container styling settings.
              4. Generate scoped CSS with backdrop filter.
              5. Validate modified AST against schema.
CHECKLIST:
  [x] Scoped lowercase ID assigned (_element_id)
  [x] CSS rules use 'selector' keyword (no global leakage)
  [x] Pre-compilation validation passed
  [x] Result[T] error envelope returned
================================================================================
"""
from __future__ import annotations

from typing import Any

from scripts.app_errors import AppError, Result
from scripts.css_engine import ScopedCssBuilder
from scripts.transform_protocol import (
    ITransformStep,
    TransformContext,
    register_transform,
)


@register_transform("HeroModernizationTransform")
class HeroModernizationTransform:
    """Sample pluggable transformation step modernizing hero section layout."""
    step_id: str = "hero_modernization"
    description: str = "Modernize hero section with dark glassmorphism"
    user_request: str = "Modernize hero section with dark glassmorphism and 60/30/10 colors"

    def compile(self, context: TransformContext) -> Result[bool]:
        target_id = context.params.get("target_id", "hero-section")
        if not target_id:
            return Result.fail(AppError("INVALID_TARGET", "Missing target_id in params"))

        return Result.ok(True)

    def modify_ast(self, ast: dict[str, Any], context: TransformContext) -> Result[dict[str, Any]]:
        elements = ast.get("elements", [])
        if not elements:
            return Result.fail(AppError("EMPTY_AST", "AST has no elements"))

        updated_ast = dict(ast)
        target_id = context.params.get("target_id", "hero-section")
        for el in updated_ast.get("elements", []):
            self._update_matching_element(el, target_id)

        return Result.ok(updated_ast)

    def _update_matching_element(self, element: dict[str, Any], target_id: str) -> None:
        el_settings = element.get("settings", {})
        el_id = el_settings.get("_element_id", "")
        if el_id == target_id:
            el_settings["background_background"] = "gradient"
            el_settings["background_color"] = "#0f172a"

    def modify_css(self, existing_css: str, context: TransformContext) -> Result[str]:
        target_selector = context.params.get("target_selector", "selector")
        rules = {
            "background": "rgba(15, 23, 42, 0.75)",
            "backdrop-filter": "blur(16px)",
            "border": "1px solid rgba(255, 255, 255, 0.1)",
            "border-radius": "16px",
        }
        built_css = ScopedCssBuilder.append_scoped_rules(existing_css, target_selector, rules)
        return Result.ok(built_css)

    def validate(self, ast: dict[str, Any]) -> Result[bool]:
        has_version = "version" in ast or "elements" in ast
        if not has_version:
            return Result.fail(AppError("VALIDATION_FAILED", "Invalid AST format"))

        return Result.ok(True)
```

### 10.17 `scripts/cli_dispatcher.py` (CLI Command Orchestrator)
```python
"""CLI entry point for WordPress automation engine with pluggable pipeline support."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# Ensure root directory is on sys.path so 'scripts.*' imports resolve cleanly
_ROOT = Path(__file__).resolve().parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from scripts.core_constants import (
    DEFAULT_BACKUP_FILENAME,
    DEFAULT_DIFF_TOLERANCE_PERCENT,
    DEFAULT_PIPELINE_FILENAME,
)
from scripts.core_enums import ExitCodeType
from scripts.pipeline_engine import FileSystemCache, PipelineWrapper
from scripts.task_logger import TaskLogger
from scripts.transform_protocol import TransformContext
from scripts.visual_diff import compute_visual_diff
from scripts.wp_auth import probe_wp_connection
from scripts.wp_rest_client import WpRestClient


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="WordPress & Elementor Automation Engine")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)
    _add_auth_subparser(subparsers)
    _add_backup_subparser(subparsers)
    _add_apply_subparser(subparsers)
    _add_diff_subparser(subparsers)
    _add_pipeline_subparser(subparsers)
    return parser


def _add_auth_subparser(subparsers: argparse._SubParsersAction) -> None:
    auth_p = subparsers.add_parser("auth", help="Probe WordPress credentials")
    auth_p.add_argument("--site-url", required=True)
    auth_p.add_argument("--username", required=True)
    auth_p.add_argument("--password", required=True)


def _add_backup_subparser(subparsers: argparse._SubParsersAction) -> None:
    backup_p = subparsers.add_parser("backup", help="Create pre-flight draft backup")
    backup_p.add_argument("--site-url", required=True)
    backup_p.add_argument("--username", required=True)
    backup_p.add_argument("--password", required=True)
    backup_p.add_argument("--page-id", type=int, required=True)


def _add_apply_subparser(subparsers: argparse._SubParsersAction) -> None:
    apply_p = subparsers.add_parser("apply", help="Apply Elementor AST to page")
    apply_p.add_argument("--site-url", required=True)
    apply_p.add_argument("--username", required=True)
    apply_p.add_argument("--password", required=True)
    apply_p.add_argument("--page-id", type=int, required=True)
    apply_p.add_argument("--ast-file", required=True)


def _add_diff_subparser(subparsers: argparse._SubParsersAction) -> None:
    diff_p = subparsers.add_parser("diff", help="Compute visual diff between screenshots")
    diff_p.add_argument("--before", required=True)
    diff_p.add_argument("--after", required=True)
    diff_p.add_argument("--out", default="assets/visual-diff.png")
    diff_p.add_argument("--tolerance", type=float, default=DEFAULT_DIFF_TOLERANCE_PERCENT)


def _add_pipeline_subparser(subparsers: argparse._SubParsersAction) -> None:
    pipe_p = subparsers.add_parser("pipeline", help="Execute JSON transformation stack")
    pipe_p.add_argument("--config", default=DEFAULT_PIPELINE_FILENAME)
    pipe_p.add_argument("--page-id", type=int, default=42)
    pipe_p.add_argument("--site-url", default="")
    pipe_p.add_argument("--username", default="")
    pipe_p.add_argument("--password", default="")
    pipe_p.add_argument("--ast-file", default="")
    pipe_p.add_argument("--out-ast", default="")
    pipe_p.add_argument("--dry-run", action="store_true")


def _handle_auth(args: argparse.Namespace, logger: TaskLogger) -> int:
    res = probe_wp_connection(args.site_url, args.username, args.password)
    if res.is_failure:
        logger.error(str(res.error))
        return ExitCodeType.AUTH_ERROR.value

    logger.success(f"Connected as: {res.value.get('name')} ({args.site_url})")
    return ExitCodeType.SUCCESS.value


def _handle_backup(args: argparse.Namespace, logger: TaskLogger) -> int:
    client = WpRestClient(args.site_url, args.username, args.password)
    res = client.create_preflight_backup(args.page_id, Path(DEFAULT_BACKUP_FILENAME))
    if res.is_failure:
        logger.error(str(res.error))
        return ExitCodeType.GENERAL_ERROR.value

    logger.success(f"Created pre-flight backup page ID: {res.value}")
    return ExitCodeType.SUCCESS.value


def _handle_apply(args: argparse.Namespace, logger: TaskLogger) -> int:
    client = WpRestClient(args.site_url, args.username, args.password)
    with open(args.ast_file, "r", encoding="utf-8") as f:
        ast_str = f.read()
    res = client.update_page_ast(args.page_id, ast_str)
    if res.is_failure:
        logger.error(str(res.error))
        return ExitCodeType.GENERAL_ERROR.value

    logger.success(f"Updated page {args.page_id} with new Elementor AST.")
    return ExitCodeType.SUCCESS.value


def _handle_diff(args: argparse.Namespace, logger: TaskLogger) -> int:
    res = compute_visual_diff(Path(args.before), Path(args.after), Path(args.out), args.tolerance)
    if res.is_failure:
        logger.error(str(res.error))
        return ExitCodeType.DIFF_ERROR.value

    logger.success(f"Visual diff passed: {res.value:.2f}% mismatch (tolerance: {args.tolerance:.2f}%)")
    return ExitCodeType.SUCCESS.value


def _load_initial_ast(ast_file: str, cache: FileSystemCache) -> dict[str, Any]:
    if ast_file and Path(ast_file).exists():
        res = cache.get_json(ast_file)
        if res.is_success:
            return res.value

    return {"version": "0.4", "elements": [{"id": "hero_1", "elType": "container", "settings": {"_element_id": "hero-section"}}]}


def _handle_pipeline(args: argparse.Namespace, logger: TaskLogger) -> int:
    cache = FileSystemCache()
    pipe_res = PipelineWrapper.from_json(args.config, cache)
    if pipe_res.is_failure:
        logger.error(str(pipe_res.error))
        return ExitCodeType.GENERAL_ERROR.value

    pipeline = pipe_res.value
    init_ast = _load_initial_ast(args.ast_file, cache)
    ctx = TransformContext(site_url=args.site_url, page_id=args.page_id, cache=cache, is_dry_run=args.dry_run)
    run_res = pipeline.execute(ctx, init_ast, "")
    if run_res.is_failure:
        logger.error(str(run_res.error))
        return ExitCodeType.GENERAL_ERROR.value

    if args.out_ast:
        Path(args.out_ast).parent.mkdir(parents=True, exist_ok=True)
        Path(args.out_ast).write_text(json.dumps(run_res.value["ast"], indent=2), encoding="utf-8")

    logger.success(f"Executed pipeline '{pipeline.name}' successfully ({run_res.value['step_count']} steps).")
    return ExitCodeType.SUCCESS.value


def main() -> int:
    parser = _build_parser()
    args = parser.parse_args()
    logger = TaskLogger()

    handlers = {
        "auth": _handle_auth,
        "backup": _handle_backup,
        "apply": _handle_apply,
        "diff": _handle_diff,
        "pipeline": _handle_pipeline,
    }
    handler = handlers.get(args.subcommand)
    if handler is None:
        logger.error(f"Unknown subcommand: {args.subcommand}")
        return ExitCodeType.USAGE_ERROR.value

    return handler(args, logger)


if __name__ == "__main__":
    sys.exit(main())
```

### 10.18 `scripts/terminal_ui.py` (VMware-Grade Hierarchical Tree & Left-Hand Padding)
```python
"""WordPress Elementor modification terminal UI with left padding and rich trees."""

from __future__ import annotations

from typing import Any
from core_constants import AnsiColorConstants


class TerminalUi:
    """Renders formatted tree diagrams, badges, and padded telemetry in the terminal."""

    LEFT_PAD = "  "  # 2-space left padding invariant for readable terminal margins

    @classmethod
    def print_workflow_header(cls, title: str) -> None:
        """Render distinct banner header with left-hand padding."""
        border = "=" * 65
        pad = cls.LEFT_PAD
        print(f"\n{pad}{AnsiColorConstants.CYAN}{border}")
        print(f"{pad}  {AnsiColorConstants.BOLD}{title}{AnsiColorConstants.RESET}")
        print(f"{pad}{AnsiColorConstants.CYAN}{border}{AnsiColorConstants.RESET}\n", flush=True)

    @classmethod
    def print_section_title(cls, icon: str, title: str) -> None:
        """Render section heading with standardized icon and left padding."""
        pad = cls.LEFT_PAD
        print(f"{pad}{icon}  {AnsiColorConstants.BOLD}{title}{AnsiColorConstants.RESET}:", flush=True)

    @classmethod
    def print_tree_node(
        cls,
        title: str,
        properties: list[tuple[str, str]],
        is_last: bool = False,
        status_badge: str = "",
    ) -> None:
        """Render a hierarchical tree node with box-drawing branches and left padding."""
        pad = cls.LEFT_PAD
        branch = "└──" if is_last else "├──"
        pipe = "   " if is_last else "│  "
        badge_str = f" {status_badge}" if status_badge else ""
        print(f"{pad}{branch} {AnsiColorConstants.BOLD}{title}{AnsiColorConstants.RESET}{badge_str}")
        prop_count = len(properties)
        for idx, (label, val) in enumerate(properties, start=1):
            sub_branch = "└──" if idx == prop_count else "├──"
            print(f"{pad}{pipe} {sub_branch} {label.ljust(20)}: {val}")
        print(f"{pad}{pipe}", flush=True)

    @classmethod
    def print_summary_card(cls, title: str, items: list[tuple[str, str, bool]]) -> None:
        """Render summary card with boolean-colored metrics and box-drawing lines."""
        pad = cls.LEFT_PAD
        print(f"{pad}📋 {AnsiColorConstants.BOLD}{title}{AnsiColorConstants.RESET}")
        total = len(items)
        for idx, (icon, label, is_ok) in enumerate(items, start=1):
            branch = "└──" if idx == total else "├──"
            c_val = f"{AnsiColorConstants.GREEN}[PASS]{AnsiColorConstants.RESET}" if is_ok else f"{AnsiColorConstants.RED}[FAIL]{AnsiColorConstants.RESET}"
            print(f"{pad}{branch} {icon} {label.ljust(24)}: {c_val}")
        print("", flush=True)

    @classmethod
    def print_error_tree(cls, operation: str, error_code: str, message: str, details: str = "") -> None:
        """Render explicit error diagnostics tree with left padding and zero swallowing."""
        pad = cls.LEFT_PAD
        border = "=" * 65
        print(f"\n{pad}{AnsiColorConstants.RED}{border}")
        print(f"{pad}  {AnsiColorConstants.BOLD}[FAIL] Execution Error: {operation}{AnsiColorConstants.RESET}")
        print(f"{pad}{AnsiColorConstants.RED}{border}{AnsiColorConstants.RESET}")
        print(f"{pad}❌ Error Code    : {error_code}")
        print(f"{pad}💬 Error Message : {message}")
        if details:
            print(f"{pad}🔍 Diagnostics   : {details}")
        print("", flush=True)
```

---

## 🖥️ Terminal Display Standard & Left-Hand Padding Invariant (VMware/CLI Grade)

Every WordPress task runner must implement `scripts/terminal_ui.py` to produce readable, polished CLI output:

1. **2-Space Left Padding Invariant (`LEFT_PAD = "  "`):**
   All lines printed to stdout must maintain a minimum of 2 leading spaces so text never sticks directly against terminal window margins or shell prompts.
2. **Hierarchical Box-Drawing Characters:**
   Use standard Unicode tree branches (`├──`, `│  `, `└──`) for site targets, page IDs, AST transformations, and visual diff passes.
3. **Status Badges & Error Trees (Zero Swallowing):**
   Badges use bracketed uppercase tokens (`[PASS]`, `[FAIL]`, `[BACKED-UP]`, `[DIFF-OK]`). Errors are displayed via explicit diagnostic trees.

